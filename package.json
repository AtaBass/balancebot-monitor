{
  "name": "balancebot-monitor",
  "version": "0.2.0",
  "description": "Turkish monitoring interface for the YTU patient assistance robot",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "type": "commonjs",
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.10",
    "expo-gl": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "three": "0.182.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/three": "0.182.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24.3.0"
  }
}
